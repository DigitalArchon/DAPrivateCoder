#!/bin/sh
# DA Private Coder's AppImage entry point. The bundled Python runs isolated (-I: no PYTHONPATH or user
# site-packages from the host); GTK and WebKitGTK come from the host (see packaging/README.md).
# `AppImage` alone opens the window; `AppImage claude-private …` starts Claude Code on the private
# models (what the claude-private command it installs runs); any other command is daprivatecoder's.
HERE="$(dirname "$(readlink -f "$0")")"
# TLS trust: the host's own CA store first, so its distrust decisions (emSign ECC Root CA - G3,
# the eMudhra root, Oct 2026) stand for httpx (SSL_CERT_FILE) and for requests, which tinfoil's
# attestation uses (REQUESTS_CA_BUNDLE); the bundled certifi is the fallback. What is set here is
# named in DAPRIVATECODER_APPRUN_SET, so Claude Code and the terminals the app opens don't get it.
set_here=""
if [ -z "${SSL_CERT_FILE:-}" ]; then
    for bundle in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/cert.pem; do
        if [ -r "$bundle" ]; then
            export SSL_CERT_FILE="$bundle"
            set_here="SSL_CERT_FILE"
            break
        fi
    done
fi
if [ -n "${SSL_CERT_FILE:-}" ] && [ -z "${REQUESTS_CA_BUNDLE:-}" ]; then
    export REQUESTS_CA_BUNDLE="$SSL_CERT_FILE"
    set_here="$set_here REQUESTS_CA_BUNDLE"
fi
export DAPRIVATECODER_APPRUN_SET="$set_here"
exec "$HERE/usr/python/bin/python3" -I -m daprivatecoder "$@"
